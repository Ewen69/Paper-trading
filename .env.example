# Copy to .env (gitignored) and fill in. Never commit real keys.

# Alpaca PAPER endpoint. The app refuses to start if this is anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Paper-account keys from https://app.alpaca.markets (Paper Trading section).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Market-data feeds. Free accounts: iex (real-time, IEX venue only) and indicative (delayed).
# sip / opra need a paid Alpaca market-data subscription; delayed_sip is 15-min delayed SIP.
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# Optional overrides (defaults shown).
# DATABASE_PATH=data/ptl.sqlite3
# REAL_TIME_MAX_AGE_SECONDS=120
# DELAYED_MAX_AGE_SECONDS=1800
# DATASET_STALE_AFTER_SESSIONS=5
# BROKER_STATUS_CACHE_SECONDS=60

# Risk limits (enforced in code on every paper order; see docs/AGENTS.md).
# RISK_MAX_LOSS_PER_TRADE=1000
# RISK_MAX_DAILY_LOSS=2000
# RISK_MAX_OPEN_POSITIONS=5
# RISK_MAX_CAPITAL_AT_RISK_PCT=0.5

# Live agents. Autopilot only queues untried in-sample work; it never runs out-of-sample tests.
# AGENTS_AUTOPILOT=true
# AGENTS_POLL_SECONDS=30
# AGENTS_MAX_COMBINATIONS=50

# Dry-run sizing capital when no paper keys are set.
# PAPER_DRY_RUN_CAPITAL=100000
